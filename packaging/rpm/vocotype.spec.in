%global debug_package %{nil}
%global __strip /bin/true

Name:           @PACKAGE_NAME@
Version:        @VERSION@
Release:        @RELEASE@%{?dist}
Summary:        @SUMMARY@
License:        GPL-3.0-or-later
URL:            https://github.com/LeonardNJU/VocoType-linux
ExclusiveArch:  x86_64
Source0:        VocoType-linux-@SOURCE_VERSION@.tar.gz

@BUILD_REQUIRES@
@REQUIRES@
@CONFLICTS@
Provides:       vocotype-linux-runtime
Recommends:     curl

%description
VoCoType provides push-to-talk offline speech input, terminology handling,
inverse text normalization, and optional AI polishing through an
OpenAI-compatible API. This flavor installs the @TITLE@ integration,
native streaming runtime, and a distro-compatible Python wheelhouse.

%prep
%autosetup -n VocoType-linux-@SOURCE_VERSION@

%build
# Native streaming and Python wheels are injected by release CI.

%install
./packaging/tools/stage-system-package.sh \
  --destdir "%{buildroot}" \
  --prefix /usr \
  --libdir "%{_lib}" \
  --libexecdir "%{_libexecdir}" \
  --build-dir "%{_builddir}/vocotype-fcitx-build-@FLAVOR@" \
  --flavor "@FLAVOR@" \
  --require-streaming-bundle \
  --require-wheelhouse

%files
%license %{_datadir}/licenses/vocotype-linux/LICENSE
%doc %{_datadir}/doc/vocotype-linux/README.md
%doc %{_datadir}/doc/vocotype-linux/CHANGELOG.md
%{_bindir}/vocotype-settings
%{_libexecdir}/vocotype-streaming-worker
%{_libdir}/vocotype/
%{_datadir}/applications/io.github.LeonardNJU.VoCoType.Settings.desktop
%{_datadir}/metainfo/io.github.LeonardNJU.VoCoType.metainfo.xml
%{_datadir}/icons/hicolor/192x192/apps/vocotype.png
%{_datadir}/vocotype/
%{_datadir}/licenses/vocotype-linux/native-streaming/
@FRAMEWORK_FILES@

%changelog
* Tue Jul 21 2026 Leonard Li <leo@lsamc.website> - @VERSION@-@RELEASE@
- Ship complete @TITLE@ package with streaming runtime and binary wheelhouse
