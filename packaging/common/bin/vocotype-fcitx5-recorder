#!/usr/bin/env bash
set -euo pipefail
for recorder in \
  "${VOCOTYPE_AUDIO_RECORDER:-}" \
  "$HOME/.local/lib/vocotype-native/bin/vocotype-audio-recorder" \
  /usr/libexec/vocotype-audio-recorder \
  /usr/lib/vocotype/vocotype-audio-recorder \
  /usr/lib64/vocotype/vocotype-audio-recorder; do
  [[ -n "$recorder" && -x "$recorder" ]] || continue
  exec "$recorder" "$@"
done
echo "VoCoType native audio recorder is not installed." >&2
exit 78
