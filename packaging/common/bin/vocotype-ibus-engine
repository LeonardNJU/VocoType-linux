#!/usr/bin/env bash
set -euo pipefail
for engine in "$HOME/.local/lib/vocotype-native/bin/vocotype-ibus-engine" /usr/libexec/vocotype-ibus-engine /usr/lib/vocotype/vocotype-ibus-engine /usr/lib64/vocotype/vocotype-ibus-engine; do
  [[ -x "$engine" ]] || continue
  exec "$engine" "$@"
done
echo "VoCoType native IBus engine is not installed." >&2
exit 78
