#!/usr/bin/env bash
set -euo pipefail
for settings in "$HOME/.local/lib/vocotype-native/bin/vocotype-settings" /usr/libexec/vocotype-settings /usr/lib/vocotype/vocotype-settings /usr/lib64/vocotype/vocotype-settings; do
  [[ -x "$settings" ]] || continue
  exec "$settings" "$@"
done
echo "VoCoType native settings center is not installed." >&2
exit 78
