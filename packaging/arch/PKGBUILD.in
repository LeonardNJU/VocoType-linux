# Maintainer: Leonard Li <leo@lsamc.website>
pkgname=@PACKAGE_NAME@
pkgver=@VERSION@
pkgrel=1
pkgdesc="@SUMMARY@"
arch=('x86_64')
options=('!debug')
url="https://github.com/LeonardNJU/VocoType-linux"
license=('GPL-3.0-or-later')
depends=(@DEPENDS@)
makedepends=(@MAKEDEPENDS@)
conflicts=(@CONFLICTS@)
replaces=(@CONFLICTS@)
provides=('vocotype-linux-runtime')
optdepends=('curl: bootstrap the recommended user Python runtime')
source=("VocoType-linux-${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

package() {
  cd "VocoType-linux-${pkgver}"
  ./packaging/tools/stage-system-package.sh \
    --destdir "$pkgdir" \
    --prefix /usr \
    --libdir lib \
    --libexecdir /usr/lib/vocotype \
    --build-dir "$srcdir/fcitx-build-@FLAVOR@" \
    --flavor "@FLAVOR@" \
    --require-streaming-bundle \
    --require-wheelhouse
}
