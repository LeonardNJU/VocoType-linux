#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CXXFLAGS_MAINT_APPEND = -Wall -Wextra -Wpedantic
PACKAGE_NAME ?= vocotype-linux
PACKAGE_FLAVOR ?= universal
%:
	dh $@
override_dh_auto_configure:
override_dh_auto_build:
	@echo "Using CI-prebuilt native FunASR/ONNX runtime"
override_dh_auto_install:
	./packaging/tools/stage-system-package.sh \
		--destdir "$(CURDIR)/debian/$(PACKAGE_NAME)" \
		--prefix /usr \
		--libdir "lib/$$(dpkg-architecture -qDEB_HOST_MULTIARCH)" \
		--build-dir "$(CURDIR)/build/debian-$(PACKAGE_FLAVOR)" \
		--flavor "$(PACKAGE_FLAVOR)" \
		--package-manager apt \
		--require-streaming-bundle
override_dh_auto_test:
	ctest --test-dir build/debian-$(PACKAGE_FLAVOR)/desktop --output-on-failure || true
override_dh_dwz:
	dh_dwz -X/vocotype/
override_dh_strip:
	dh_strip -X/vocotype/
