<dict>
  <key>CFBundleDevelopmentRegion</key><string>zh_CN</string>
  <key>CFBundleDisplayName</key><string>VoCoType-linux</string>
  <key>CFBundleExecutable</key><string>VoCoTypeLinuxSettings</string>
  <key>CFBundleIdentifier</key><string>io.github.LeonardNJU.VoCoTypeLinux.Settings</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
