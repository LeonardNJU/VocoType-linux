  <name xml:lang="zh-CN">VoCoType</name>
  <summary>Offline voice input for IBus and Fcitx 5</summary>
  <summary xml:lang="zh-CN">适用于 IBus 与 Fcitx 5 的离线语音输入法</summary>
  <metadata_license>CC0-1.0</metadata_license>
